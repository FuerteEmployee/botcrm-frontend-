VITE_API_URL=https://api2.beontimeofficial.com/api

# Companies kept on the previous release (same ids as the backend's
# FROZEN_TENANT_IDS). botcrm moves their browsers to the classic site.
VITE_FROZEN_TENANTS=6a2d11c3bee6693b7ae623ab
