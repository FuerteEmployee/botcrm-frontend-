VITE_API_URL=http://localhost:5000/api

# BOTLens camera app, opened in a new tab from the sidebar's "Lens" item.
VITE_BOTLENS_URL=http://localhost:8000

# VITE_SOCKET_URL is deliberately unset: the backend has no Socket.IO server,
# so setting it made every phone retry a 404 websocket every few seconds.
# Locations already upload over REST (/tracking/update).
